{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memento",
  "version": "2.8.0",
  "identifier": "com.zhulongqihan.memento",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "几度 · Memento",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "人生时间感知与记录",
    "longDescription": "几度 · Memento 是一款安静的人生时间记录应用。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
