{
  "name": "memento-desktop",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run --exclude output/**",
    "copy:validate": "node scripts/build-copy-library.mjs --validate",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:portable": "node scripts/build-windows-release.mjs portable",
    "tauri:build:installer": "node scripts/build-windows-release.mjs installer",
    "tauri:build": "node scripts/build-windows-release.mjs all",
    "tauri:test:isolated": "node scripts/build-isolated-tauri-test.mjs",
    "test:ui": "node scripts/verify-browser.mjs",
    "test:native": "node scripts/verify-native-windows.mjs",
    "release:verify": "node scripts/release-manifest.mjs verify"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-sql": "^2.2.0",
    "date-fns": "^4.1.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.64.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
